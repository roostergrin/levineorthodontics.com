form.form-appointment
  input(placeholder='Your Full Name*').form-appointment__input
  input(placeholder='Your Email Address*').form-appointment__input
  input(placeholder='Your Phone Number*').form-appointment__input
  textarea(placeholder='Message*' rows='4').form-appointment__input.form-appointment__input--textarea
  input(type='submit' value='Send').form-appointment__input.form-appointment__input--button
    
