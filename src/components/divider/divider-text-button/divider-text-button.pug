.divider-text-button
  .divider-text-button__bg(:style="{ backgroundImage: 'url(' + props.image + ')' }")
    .divider-text-button__overlay
      .divider-text-button__scroll(:id='props.id')
      .divider-text-button__container(:class="{ 'divider-text-button__container--active': active, 'divider-text-button__container--left': props.location === 'Left', 'divider-text-button__container--right': props.location === 'Right' }")
        .divider-text-button__waypoint(v-waypoint='{ active: true, callback: activate }')
        .divider-text-button__body
          .divider-text-button__subtitle(v-html='props.subtitle')
          .divider-text-button__title(v-html='props.title')
          .divider-text-button__cta(v-html='props.cta')
          .divider-text-button__cta1(v-if='props.link')
            a(:href='props.link', v-show='props.button')
              .divider-text-button__button(v-html='props.button')
          .divider-text-button__cta(v-if='props.widtxt')
            span.divider-text-button__openchair.openchair-widget(v-html='props.widtxt')
