.nav-mobile
  .nav-mobile__container
    router-link.nav-mobile__logo(to='/')
      Icon(:name='props.logo')
      
    .nav-mobile__hamburger(@click='openNav', :class="{ 'nav-mobile__hamburger--active': navActive }")
      span
      span
      span
  
  .nav-mobile__drawer(:class="{ 'nav-mobile__drawer--active': navActive }")
    .nav-mobile__links
      router-link.nav-mobile__link(v-for='(link, i) in links', :key='i' v-if='link.navigation', :to='link.path' v-html='link.name', :class="{ 'nav-mobile__link--active': navActive }")
