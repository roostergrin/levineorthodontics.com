.nav-tablet
  .nav-tablet__container
    router-link.nav-tablet__logo(to='/')
      Icon(:name='props.logo')
      
    .nav-tablet__left    
      a.nav-tablet__button(:href='props.href')
        | {{ props.label }}
      
      .nav-tablet__hamburger(@click='openNav', :class="{ 'nav-tablet__hamburger--active': navActive }")
        span
        span
        span
  
  .nav-tablet__drawer(:class="{ 'nav-tablet__drawer--active': navActive }")
    .nav-tablet__links
      router-link.nav-tablet__link(v-for='(link, i) in links', :key='i' v-if='link.navigation', :to='link.path' v-html='link.name', :class="{ 'nav-tablet__link--active': navActive }")
