footer.footer(v-if='props')
  .footer__bg
    .footer__container
      .footer__title
        | Levine Orthodontics
      .footer__location(v-html='props.acf.location')
      .footer__social
        a(href='http://facebook.com/levineorthodontics' target='_blank' aria-label="facebook")
          Icon(name='facebook').footer__icon
        a(href='https://www.youtube.com/user/LevineOrtho' target='_blank' aria-label="youtube")
          Icon(name='youtube').footer__icon
        a(href='https://www.instagram.com/levineorthodontics' target='_blank' aria-label="instagram")
          Icon(name='instagram-01').footer__icon

  .footer__divider
    .footer__container.footer__bottom-bar
      .footer__links
        a(href='/privacy-policy') Privacy Policy
        |  • 
        a(href='/hipaa-privacy-supplement') HIPAA Privacy Supplement
        |  • 
        a(href='/terms-of-use') Terms of Use
        |  • 
        a(href='/cookie-notice') Cookie Notice

      .footer__trade
        span#accessibilityWidget Click for Accessibility 
        span | 
        | Rooster Grin Media
