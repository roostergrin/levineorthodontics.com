.hero
  swiper.hero__slider(ref='heroSwiper', v-if='$route.name === "home"', :options='swiperOption')
    swiper-slide.hero__slide(v-for='(slide, index) in homeSlides', :key='slide.image')
      .hero__image
        picture.hero__picture(v-if='shouldLoadSlide(index)')
          source(v-if='slide.webp', :srcset='slide.webp', type='image/webp')
          img.hero__image-img(:src='slide.image', :alt='slide.alt', :width='slide.width', :height='slide.height', :loading='index === 0 ? "eager" : "lazy"', :decoding='index === 0 ? "sync" : "async"', :fetchpriority='index === 0 ? "high" : null')
  
    .hero__slide-button-next(slot='button-next')
      Icon(name='arrow-right')      
    .hero__slide-button-prev(slot='button-prev')
      Icon(name='arrow-left')

  .hero__image--option(:style="{ backgroundImage: 'url(' + props.image + ')' }", v-if='$route.name !== "home"')
    .hero__text-overlay(v-if='props.heading')
      .hero__text-content
        h1.hero__heading(v-html='props.heading')
        span.hero__openchair.openchair-widget(v-html='props.btntxt')
  .hero__waypoint(v-waypoint='{ active: true, callback: changeNav }')
  .hero__scroll
    Icon(name='arrow-right', class='hero__scroll--arrow')
