.hero(:class="{ 'hero--secondary-ready': secondaryImagesReady }")
  swiper.hero__slider(v-if='$route.name === "home"', :options='swiperOption')
    swiper-slide.hero__slide(v-for='i in 5', :key='i')
      .hero__image(:class="'hero__image--' + i")
  
    .hero__slide-button-next(slot='button-next', @mouseenter='loadSecondaryHeroImages', @touchstart='loadSecondaryHeroImages', @click='loadSecondaryHeroImages')
      Icon(name='arrow-right')      
    .hero__slide-button-prev(slot='button-prev', @mouseenter='loadSecondaryHeroImages', @touchstart='loadSecondaryHeroImages', @click='loadSecondaryHeroImages')
      Icon(name='arrow-left')

  .hero__image--option(:style="{ backgroundImage: 'url(' + props.image + ')' }", v-if='$route.name !== "home"')
    .hero__text-overlay(v-if='props.heading')
      .hero__text-content
        h1.hero__heading(v-html='props.heading')
        span.hero__openchair.openchair-widget(v-html='props.btntxt')
  .hero__waypoint(v-waypoint='{ active: true, callback: changeNav }')
  .hero__scroll
    Icon(name='arrow-right', class='hero__scroll--arrow')
