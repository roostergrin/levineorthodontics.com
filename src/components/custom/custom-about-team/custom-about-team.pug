.custom-about-team
  .custom-about-team__title(v-html='props.title', :class="{ 'fade': active >= 1 }")
  Trigger(:props='1' v-if='active <= 1' style="top: 10%")
  .custom-about-team__container
    .custom-about-team__subtitle(v-html='props.subtitle')
  .custom-about-team__container
    swiper.custom-about-team__slider(:options='swiperOptions' ref='mySwiper')
      swiperSlide.custom-about-team__slide(v-for='(slide, i) in props.staff', :key='i')
        .custom-about-team__image-box
          .custom-about-team__image(:style="{ backgroundImage: 'url(' + slide.image + ')' }")
        .custom-about-team__content
          .custom-about-team__text-box
            .custom-about-team__headers
              hr.custom-about-team__dash
              .custom-about-team__name-text
                | Name
                .custom-about-team__text(v-html='slide.name')
            .custom-about-team__headers
              hr.custom-about-team__dash
              .custom-about-team__name-text
                | Position
                .custom-about-team__text(v-html='slide.position')
          .custom-about-team__body(v-html='slide.bio')
              
      .custom-about-team__navigation
        .custom-about-team__tile(v-for='(item, i) in props.staff', :key='i' @click='swiper.slideTo(i), slideTo(i)', :class="{ 'custom-about-team__tile--active': activeIndex === i }")
          .custom-about-team__tile-image(:style="{ backgroundImage: 'url(' + item.image + ')'}")
