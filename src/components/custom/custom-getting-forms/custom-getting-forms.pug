.custom-getting-forms
  .custom-getting-forms__title(v-html='props.title', :class="{ 'fade': active >= 1 }")
  Trigger(:props='1' v-if='active <= 1' style="top: 10%")
  .custom-getting-forms__container
    .custom-getting-forms__center
      .custom-getting-forms__body(v-html='props.subtitle')
        
  .custom-getting-forms__container
    .custom-getting-forms__buttons
      .custom-getting-forms__button(v-for='(button, i) in props.forms', :href='button.href')
        | {{ button.label }}
        svg
          rect(x='0' y='0' width='100%' height='100%')
