.custom-home-doctor 
  .custom-home-doctor__container
    .custom-home-doctor__waypoint(v-waypoint='{ active: true, callback: change }')
    .custom-home-doctor__left
      .custom-home-doctor__image()
        
    .custom-home-doctor__right(:class="{ 'custom-home-doctor__right--active': active }")
      .custom-home-doctor__body
        .custom-home-doctor__subtitle(v-html='props.subtitle')
        .custom-home-doctor__title(v-html='props.title')
        .custom-home-doctor__content(v-html='props.content')
  
