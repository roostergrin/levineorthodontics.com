.custom-getting-finance
  .custom-getting-finance__title(v-html='props.title', :class="{ 'fade': active >= 1 }")
  Trigger(:props='1' v-if='active <= 1' style="top: 10%")
  .custom-getting-finance__container
    .custom-getting-finance__left
      .custom-getting-finance__body(v-html='props.body')
      hr.custom-getting-finance__line
    .custom-getting-finance__right
      .custom-getting-finance__image(:style="{ backgroundImage: 'url(' + props.image + ')' }")
