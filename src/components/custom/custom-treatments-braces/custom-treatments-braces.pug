.custom-treatments-braces
  .custom-treatments-braces__title(v-html='props.title')
  .custom-treatments-braces__container
    .custom-treatments-braces__subtitle(v-html='props.subtitle')
  .custom-treatments-braces__container.custom-treatments-braces__container--alt
    .custom-treatments-braces__tile(v-for='(tile, i) in props.tiles', :style="{ backgroundImage: 'url(' + tile.image + ')' }")
      .custom-treatments-braces__content
        .custom-treatments-braces__header(v-html='tile.title')
        .custom-treatments-braces__button(v-html='tile.label')
      .custom-treatments-braces__overlay
        .custom-treatments-braces__overlay-text(v-html='tile.body')
  .custom-treatments-braces__container
    .custom-treatments-braces__image-box(v-for='(image, i) in props.bottom', :key='i')
      .custom-treatments-braces__image(:style="{ backgroundImage: 'url(' + image.image + ')' }")
      
