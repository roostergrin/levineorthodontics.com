.block-text-button
  .block-text-button__container
    .block-text-button__subtitle(v-html='props.subtitle')
    .block-text-button__title(v-html='props.title')
    .block-text-button__content(v-html='props.content')
    .block-text-button__container-option
      .block-text-button__button(v-html='props.button' @click='$router.push(props.link)')
