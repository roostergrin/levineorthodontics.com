.block-text
  .block-text__container(:class="{'block-text__container--active': active}", :id='props.id')
    .block-text__subtitle(v-html='props.subtitle', v-if='!props.subtitle_h1')
    h1.block-text__subtitle(v-html='props.subtitle', v-if='props.subtitle_h1')
    .block-text__title(v-html='props.title', v-if='!props.title_h1')
    h1.block-text__title(v-html='props.title', v-if='props.title_h1')
    .block-text__waypoint(v-waypoint='{ active: true, callback: change }')
    .block-text__content(v-html='props.content')
